# Hosted build (Vercel): read the live Sepolia deployment. Never commit a keyed RPC here. On Vercel,
# VITE_LEASH_RPC is set in the project's environment variables (an Alchemy URL restricted to the site's
# domain) and wins over this public fallback, which rate limits a busy dashboard.
VITE_LEASH_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Wide eth_getLogs scans (the history read at load): Alchemy's free plan serves 10 blocks per call at most,
# these public RPCs serve 50k. Comma separated, the next one takes over when one rate limits.
VITE_LEASH_LOGS_RPC=https://sepolia.gateway.tenderly.co,https://ethereum-sepolia-rpc.publicnode.com
# Reown AppKit project id (wallet connection on the hosted site). Public by design; allowed domains are set
# in the Reown dashboard.
VITE_REOWN_PROJECT_ID=29233b482a4fece3dc6f7914038ce8cc
