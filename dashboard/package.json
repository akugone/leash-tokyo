{
  "name": "leash-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read only dashboard for a Leash agent name: policy, spend, expiry and swaps, polled every 5 seconds",
  "scripts": {
    "sync-deployments": "bun run scripts/sync-deployments.ts",
    "record-demo": "bun run scripts/record-demo.ts",
    "record-live": "bun run scripts/record-live.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.ts\" index.html README.md"
  },
  "dependencies": {
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.63.0",
    "prettier": "^3.5.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.0"
  }
}
