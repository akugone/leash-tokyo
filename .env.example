# RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Where scripts read and write the deployment record (see script/Deployments.sol).
# Use deployments/anvil.json when running the demo against a local fork.
LEASH_DEPLOYMENTS_FILE=deployments/sepolia.json

# The three demo keys. Generate FRESH ones with `cast wallet new`, never reuse anvil's well-known accounts:
# on Sepolia those addresses carry EIP-7702 delegations (sweeper bots), so the fork sees code at them and
# the ENS registry mint reverts in onERC1155Received. script/demo.sh funds these addresses on the anvil fork.
# owner: holds the parent .eth name and root roles on the org registry and resolver
OWNER_PK=
# risk-manager: may only write leash.dailyNotional and leash.tokens on the org resolver
RISK_MANAGER_PK=
# agent: signs swap intents and trades from the org vault, holds only gas ETH, owns no ENS name
AGENT_PK=

# Names
PARENT_LABEL=leashdemo
AGENT_LABEL=trader-1

# Verification (Sepolia only)
ETHERSCAN_API_KEY=
