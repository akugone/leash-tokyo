{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd dashboard && bun install --frozen-lockfile",
  "buildCommand": "cd dashboard && LEASH_ENV=sepolia bun run sync-deployments && bun run build",
  "outputDirectory": "dashboard/dist",
  "rewrites": [{ "source": "/app", "destination": "/index.html" }]
}
